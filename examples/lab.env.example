# StrataBench lab cluster config — copy to lab.env and edit for your cluster.
# Usage: source examples/lab.env   OR   export $(grep -v '^#' examples/lab.env | xargs)

# --- SSH / install (bootstrap + sync) ---
LAB_SSH_USER=root
# LAB_SSH_KEY=~/.ssh/id_rsa
INSTALL_DIR=/opt/stratabench

# Host IPs only (no ports) — agents installed here
LAB_CLIENT_HOSTS=10.0.1.1,10.0.1.2,10.0.1.3
LAB_AGENT_PORT=7777

# S3 / MinIO endpoints (host:port) — storage under test
LAB_S3_ENDPOINTS=10.0.1.10:9000,10.0.1.11:9000

# Block targets (optional) — comma-separated devices on clients or shared LUNs
# LAB_BLOCK_TARGET=/dev/nvme0n1

# --- Credentials ---
WARP_ACCESS_KEY=minioadmin
WARP_SECRET_KEY=minioadmin

# --- Tool versions (bootstrap) ---
WARP_VERSION=v1.1.0
# INSTALL_VDBENCH=false
# INSTALL_SPDK=false

# --- Default benchmark (lab-run.sh) ---
LAB_PROFILE=s3-cluster-rdma
LAB_TOPOLOGY=shard
# LAB_DURATION overrides profile duration via agent intent — use CLI flags instead

# --- Coordinator paths (after make build) ---
STRATABENCH_BIN=./bin/stratabench
STRATABENCH_DATA=~/.stratabench
