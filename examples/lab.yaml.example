# StrataBench lab cluster — copy to lab.yaml and edit.
# Or use lab.env (see examples/lab.env.example)

ssh:
  user: root
  # key: ~/.ssh/id_rsa

install_dir: /opt/stratabench
agent_port: 7777

clients:
  - host: 10.0.1.1
  - host: 10.0.1.2
  - host: 10.0.1.3

# Block/file/app targets — used automatically by `stratabench lab run <profile>`
targets:
  block: /dev/sdb              # HDD/NVMe (hdd-sequential-read, nvme-random-oltp, fio)
  afa_luns: /dev/sdb,/dev/sdc  # vdbench multi-LUN
  file: /mnt/nfs/share         # elbencho file profiles
  spdk_pci: "0000:01:00.0"
  postgres_dsn: postgres://bench@10.0.1.5/stratabench
  kafka: 10.0.1.30:9092
  rocksdb_path: /data/rocksdb
  vm_block: root@10.0.1.20:/dev/vdb

# S3 servers — only needed for object/warp/gosbench profiles
servers:
  - host: 10.0.1.10
    port: 9000
    role: s3
  - host: 10.0.1.11
    port: 9000
    role: s3

s3:
  deploy: docker       # docker | external | skip
  access_key: minioadmin
  secret_key: minioadmin
  bucket: stratabench-test

tools:
  warp_version: v1.1.0
  install_fio: true
  install_vdbench: false
  # vdbench_path: /opt/vdbench/vdbench

firewall:
  apply: false         # set true to run ufw allow on nodes
  open_ports: [7777, 9000, 9001]

default_run:
  profile: hdd-sequential-read   # or s3-cluster-rdma, app-postgres-tpc-c, etc.
  topology: single               # auto-inferred when omitted

bin_dir: bin
profiles_dir: profiles
