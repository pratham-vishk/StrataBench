# StrataBench lab cluster — copy to lab.yaml and edit.
# Or use lab.env (see examples/lab.env.example)

ssh:
  user: root
  # key: ~/.ssh/id_rsa

install_dir: /opt/stratabench
agent_port: 7777

clients:
  - host: 10.0.1.1
  - host: 10.0.1.2
  - host: 10.0.1.3

servers:
  - host: 10.0.1.10
    port: 9000
    role: s3
  - host: 10.0.1.11
    port: 9000
    role: s3

s3:
  deploy: docker       # docker | external | skip
  access_key: minioadmin
  secret_key: minioadmin
  bucket: stratabench-test

tools:
  warp_version: v1.1.0
  install_fio: true
  install_vdbench: false
  # vdbench_path: /opt/vdbench/vdbench

firewall:
  apply: false         # set true to run ufw allow on nodes
  open_ports: [7777, 9000, 9001]

default_run:
  profile: s3-cluster-rdma
  topology: shard

bin_dir: bin
profiles_dir: profiles
