{
  "annotations": { "list": [] },
  "title": "StrataBench",
  "uid": "stratabench-main",
  "panels": [
    {
      "type": "timeseries",
      "title": "IOPS",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "stratabench_iops",
          "legendFormat": "{{profile}} {{run_id}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Throughput MB/s",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "stratabench_throughput_mbps",
          "legendFormat": "{{profile}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p99 Latency (µs)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "stratabench_latency_p99_us",
          "legendFormat": "{{profile}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Run assignment progress (live)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "stratabench_run_assignment_progress",
          "legendFormat": "{{profile}} {{phase}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 }
      }
    },
    {
      "type": "stat",
      "title": "Total Runs",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 },
      "targets": [
        { "expr": "sum(stratabench_runs_total)" }
      ]
    },
    {
      "type": "stat",
      "title": "Active assignments",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 16 },
      "targets": [
        { "expr": "sum(stratabench_run_assignments_total)" }
      ]
    }
    {
      "type": "timeseries",
      "title": "Live interval IOPS",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "stratabench_live_iops",
          "legendFormat": "{{profile}} {{run_id}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Live interval throughput (MB/s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "stratabench_live_throughput_mbps",
          "legendFormat": "{{profile}}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 3
}
